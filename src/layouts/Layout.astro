---
import { ClientRouter } from 'astro:transitions';
import type { Favicons } from '@mintlify/astro/helpers';
import { AssistantSheet, AssistantProvider } from '../components/Assistant';
import docsConfig from '../../docs/docs.json';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  favicons?: Favicons;
}

const { title = 'Mintlify Docs', description, favicons } = Astro.props;
const primaryColor = docsConfig.colors?.primary;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    {
      favicons?.icons &&
        favicons.icons.map((icon) => (
          <link
            rel={icon.rel}
            type={icon.type}
            sizes={icon.sizes}
            href={icon.href}
            media={icon.media}
          />
        ))
    }
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <ClientRouter />
  </head>
  <body style={primaryColor ? `--primary: ${primaryColor}` : ''}>
    <AssistantProvider client:only="react" />
    <div class="flex">
      <div class="flex-1 min-w-0 max-w-[1400px] mx-auto w-full">
        <slot />
      </div>
      <AssistantSheet client:only="react" transition:persist />
    </div>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    overscroll-behavior-y: none;
  }

  ::view-transition-old(*),
  ::view-transition-new(*),
  ::view-transition-group(*) {
    animation-duration: 0s !important;
  }
</style>
