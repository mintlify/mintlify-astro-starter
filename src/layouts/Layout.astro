---
import type { Favicons } from '../integrations/mintlify/types';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	favicons?: Favicons;
}

const { title = 'Mintlify Docs', description, favicons } = Astro.props;
---

<!doctype html>
<html lang="en" style="color-scheme: light;">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="color-scheme" content="light" />
		{favicons?.icons && favicons.icons.map((icon) => (
			<link rel={icon.rel} type={icon.type} sizes={icon.sizes} href={icon.href} media={icon.media} />
		))}
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
	</head>
	<body>
		<slot />
	</body>
</html>
