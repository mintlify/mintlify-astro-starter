---
import type { TabInfo } from '../lib/navigation';
import { SearchBar } from './SearchBar';
import AssistantBar from './AssistantBar';

interface Props {
  logo?: string;
  name?: string;
  tabs: TabInfo[] | null;
  primaryColor?: string;
}

const { logo, name, tabs, primaryColor } = Astro.props;
---

<header class="sticky top-0 z-50 bg-white">
  <nav class="h-16 border-b border-gray-200/60">
    <div class="h-full w-full max-w-360 mx-auto px-4 sm:px-6 lg:px-8">
      <div class="h-full flex items-center gap-4 min-w-0">
        <div class="flex-1 flex items-center gap-4 min-w-0">
          <a href="/" class="flex items-center gap-2.5">
            <img src={logo} alt={name} />
          </a>
        </div>
        <div
          class="relative flex-1 flex items-center gap-3 z-20 justify-center"
        >
          <div class="w-full max-w-sm">
            <SearchBar client:load />
          </div>
          <div class="shrink-0" transition:persist="assistant-bar">
            <AssistantBar client:load />
          </div>
        </div>
        <div class="flex-1 flex items-center justify-end gap-4"></div>
      </div>
    </div>
  </nav>

  {
    tabs && tabs.length > 0 && (
      <div class="w-full max-w-360 mx-auto px-4 sm:px-6 lg:px-8 border-b border-gray-100">
        <div class="flex gap-5">
          {tabs.map((tab) => (
            <a
              href={tab.href}
              class:list={[
                'relative py-3 text-sm leading-5 no-underline whitespace-nowrap border-b-2 -mb-px transition-colors duration-150',
                tab.isActive
                  ? 'text-gray-900 font-semibold'
                  : 'text-gray-400 font-medium border-transparent hover:text-gray-500',
              ]}
              style={
                tab.isActive
                  ? `border-bottom-color: ${primaryColor}`
                  : undefined
              }
            >
              {tab.name}
            </a>
          ))}
        </div>
      </div>
    )
  }
</header>
