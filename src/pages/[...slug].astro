---
import Layout from '../layouts/Layout.astro';
import { getDecoratedNavigation, getRenderedMdxPage, extractAllPaths, hrefToSlug, type DecoratedPage, type RenderedMdxPage } from '../lib/mintlify';

export async function getStaticPaths() {
  const nav = await getDecoratedNavigation();
  const MAX_PAGES_FOR_TESTING = 50; // This is a testing limit just to reduce the number of requests to the Mintlify API.
  const allPages = extractAllPaths(nav).slice(0, MAX_PAGES_FOR_TESTING);

  return await Promise.all(allPages.map(async (page) => {
    const slug = hrefToSlug(page.href);
    const renderedMdx = await getRenderedMdxPage(page.href);
    
    const isIndexPage = slug.length === 1 && slug[0] === 'index';
    const slugParam = (isIndexPage || slug.length === 0) ? undefined : slug.join('/');
    
    return {
      params: { slug: slugParam },
      props: { page, allPages, renderedMdx },
    };
  }));
}

interface Props {
  page: DecoratedPage;
  allPages: DecoratedPage[];
  renderedMdx: RenderedMdxPage;
}

const { page, allPages, renderedMdx } = Astro.props;
---

<Layout title={page.title} description={page.description}>
  <div class="container">
    <aside class="sidebar">
      <nav>
        <h3>Navigation</h3>
        <ul>
          {allPages.map((p) => (
            <li class={p.href === page.href ? 'active' : ''}>
              <a href={p.href}>
                {p.sidebarTitle || p.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>

    <main class="content">
      <article>
        <h1>{page.title}</h1>
        {page.description && <p class="description">{page.description}</p>}

        <div class="meta">
          <p><strong>Path:</strong> {page.href}</p>
          {page.lastUpdatedDate && <p><strong>Last updated:</strong> {page.lastUpdatedDate}</p>}
          {page.deprecated && <p class="deprecated">This page is deprecated</p>}
        </div>

        <div class="mdx-content" set:html={renderedMdx.html} />
      </article>
    </main>
  </div>
</Layout>

<style>
  .container {
    display: flex;
    min-height: 100vh;
  }

  .sidebar {
    width: 250px;
    padding: 1rem;
    background: #f5f5f5;
    border-right: 1px solid #ddd;
    overflow-y: auto;
  }

  .sidebar h3 {
    margin-top: 0;
    font-size: 1rem;
    color: #333;
  }

  .sidebar ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sidebar li {
    margin: 0.25rem 0;
  }

  .sidebar a {
    display: block;
    padding: 0.5rem;
    text-decoration: none;
    color: #333;
    border-radius: 4px;
    font-size: 0.875rem;
  }

  .sidebar a:hover {
    background: #e0e0e0;
  }

  .sidebar li.active a {
    background: #0070f3;
    color: white;
  }

  .content {
    flex: 1;
    padding: 2rem;
    max-width: 800px;
  }

  h1 {
    margin-top: 0;
    font-size: 2rem;
  }

  .description {
    font-size: 1.125rem;
    color: #666;
    margin-bottom: 2rem;
  }

  .meta {
    background: #f9f9f9;
    padding: 1rem;
    border-radius: 8px;
    margin-bottom: 2rem;
  }

  .meta p {
    margin: 0.5rem 0;
    font-size: 0.875rem;
  }

  .deprecated {
    color: #d32f2f;
    font-weight: bold;
  }

  .mdx-content {
    line-height: 1.6;
  }

  .mdx-content :global(h2) {
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-size: 1.5rem;
    font-weight: 600;
  }

  .mdx-content :global(h3) {
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .mdx-content :global(p) {
    margin-bottom: 1rem;
  }

  .mdx-content :global(code) {
    background: #f5f5f5;
    padding: 0.2em 0.4em;
    border-radius: 3px;
    font-size: 0.9em;
    font-family: 'Courier New', Courier, monospace;
  }

  .mdx-content :global(pre) {
    background: #f5f5f5;
    padding: 1rem;
    border-radius: 8px;
    overflow-x: auto;
    margin-bottom: 1rem;
  }

  .mdx-content :global(pre code) {
    background: none;
    padding: 0;
  }

  .mdx-content :global(ul),
  .mdx-content :global(ol) {
    margin-bottom: 1rem;
    padding-left: 2rem;
  }

  .mdx-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .mdx-content :global(a) {
    color: #0070f3;
    text-decoration: none;
  }

  .mdx-content :global(a:hover) {
    text-decoration: underline;
  }
</style>
