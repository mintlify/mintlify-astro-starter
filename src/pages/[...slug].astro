---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer';
import SiteFooter from '../components/SiteFooter';
import { components } from '@mintlify/astro/components';
import { resolvePageData } from '@mintlify/astro/helpers';
import type { DocsConfig } from '@mintlify/astro';
import docsConfig from '../../docs/docs.json';
import Sidebar, { MobileSidebar } from '../components/Sidebar';
import TableOfContents from '../components/TableOfContents';

export async function getStaticPaths() {
  const docs = await getCollection('docs');

  return docs.map((doc) => {
    const slug = doc.id === 'index' ? undefined : doc.id;
    return {
      params: { slug },
      props: { doc, allDocs: docs },
    };
  });
}

const { doc, allDocs } = Astro.props;
const { Content, headings } = await render(doc);

const titleMap = Object.fromEntries(
  allDocs.map((doc) => [doc.id, doc.data.title || doc.id]),
);
const currentPath = doc.id === 'index' ? '/' : `/${doc.id}`;
const page = resolvePageData(docsConfig as DocsConfig, {
  currentPath,
  titleMap,
});
---

<Layout
  title={doc.data.title || doc.id}
  description={doc.data.description}
  favicons={page.favicons}
>
  <div
    style={`--primary: ${docsConfig.colors?.primary}; --color-primary: ${docsConfig.colors?.primary}`}
  >
    <Header
      logo={docsConfig.logo?.light}
      name={docsConfig.name}
      tabs={page.tabs}
      primaryColor={docsConfig.colors?.primary}
      pageTitle={doc.data.title || doc.id}
      groupName={page.groupName}
    />

    <MobileSidebar
      navigation={page.navigation}
      currentPath={currentPath}
      logo={docsConfig.logo?.light}
      siteName={docsConfig.name}
      tabs={page.tabs || []}
      anchors={page.anchors}
      primaryColor={docsConfig.colors?.primary}
      client:load
    />

    <div class="w-full px-4 lg:px-0 pt-3 lg:pt-0">
      <div class="flex lg:gap-10 min-h-[calc(100vh-4rem)]">
        <div transition:animate="none">
          <Sidebar
            navigation={page.navigation}
            currentPath={currentPath}
            anchors={page.anchors}
            primaryColor={docsConfig.colors?.primary}
            client:load
          />
        </div>

        <main class="flex-1 min-w-0 py-10">
          <article class="w-full">
            <header class="leading-none pb-8">
              <div class="mt-0.5 space-y-2.5">
                {
                  page.groupName && (
                    <p
                      class="text-sm font-semibold"
                      style={`color: ${docsConfig.colors?.primary ?? '#16A34A'}`}
                    >
                      {page.groupName}
                    </p>
                  )
                }
                <h1
                  class="text-2xl sm:text-3xl text-gray-900 tracking-tight font-bold wrap-anywhere"
                >
                  {doc.data.title || doc.id}
                </h1>
              </div>
              {
                doc.data.description && (
                  <div class="mt-2 text-lg prose prose-gray max-w-2xl">
                    <p>{doc.data.description}</p>
                  </div>
                )
              }
            </header>
            <div class="mdx-content prose max-w-none">
              <Content components={components} />
              <Footer
                prev={page.footerPages.prev}
                next={page.footerPages.next}
              />
            </div>
          </article>
          <SiteFooter socials={docsConfig.footer?.socials} client:load />
        </main>

        <TableOfContents headings={headings} client:load />
      </div>
    </div>
  </div>
</Layout>
