---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import Footer from '../components/Footer';
import { components } from '../integrations/mintlify/utils/mintlify-components';
import favicons from '../content/generated/favicons.json';
import docsConfig from '../../docs/docs.json';
import Sidebar from '../components/Sidebar';
import {
  decorateNavigation,
  unwrapNav,
  findGroupForPath,
  getTabsFromNav,
  getFooterPages,
} from '../lib/navigation';

export async function getStaticPaths() {
  const docs = await getCollection('docs');

  return docs.map((doc) => {
    const slug = doc.id === 'index' ? undefined : doc.id;
    return {
      params: { slug },
      props: { doc, allDocs: docs },
    };
  });
}

const { doc, allDocs } = Astro.props;
const { Content } = await render(doc);

const titleMap = Object.fromEntries(
  allDocs.map((doc) => [doc.id, doc.data.title || doc.id]),
);

const decoratedNav = decorateNavigation(docsConfig.navigation, titleMap);

const currentPath = doc.id === 'index' ? '/' : `/${doc.id}`;
const sidebarEntries = unwrapNav(decoratedNav, currentPath);
const groupName = findGroupForPath(sidebarEntries, currentPath);
const tabs = getTabsFromNav(decoratedNav, currentPath);
const { prev, next } = getFooterPages(sidebarEntries, currentPath);
---

<Layout
  title={doc.data.title || doc.id}
  description={doc.data.description}
  favicons={favicons}
>
  <div style={`--sidebar-primary: ${docsConfig.colors?.primary}`}>
    <Header
      client:load
      logo={docsConfig.logo?.light}
      name={docsConfig.name}
      tabs={tabs}
      primaryColor={docsConfig.colors?.primary}
    />

    <div
      class="flex min-h-[calc(100vh-7.5rem)] w-full max-w-360 mx-auto px-4 sm:px-6 lg:px-8"
    >
      <div transition:animate="none">
        <Sidebar navigation={decoratedNav} currentPath={currentPath} />
      </div>

      <main class="flex-1 min-w-0 py-10 px-8 lg:px-12">
        <article class="max-w-3xl mx-auto">
          <header class="mb-8 pb-6">
            {
              groupName && (
                <p
                  class="text-sm font-semibold mb-2"
                  style={`color: ${docsConfig.colors?.primary ?? '#16A34A'}`}
                >
                  {groupName}
                </p>
              )
            }
            <h1
              class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 mb-3"
            >
              {doc.data.title || doc.id}
            </h1>
            {
              doc.data.description && (
                <p class="text-lg leading-relaxed max-w-2xl">
                  {doc.data.description}
                </p>
              )
            }
          </header>
          <div class="mdx-content prose">
            <Content components={components} />
            <Footer prev={prev} next={next} />
          </div>
        </article>
      </main>

      <div class="w-[16rem] shrink-0 max-lg:hidden"></div>
    </div>
  </div>
</Layout>
